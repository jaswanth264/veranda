# Supabase — get JWT keys from: supabase status --output env
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-jwt-key-here         # ANON_KEY from supabase status
SUPABASE_SERVICE_KEY=your-service-role-key-here   # SERVICE_ROLE_KEY from supabase status

# Server
PORT=5000

# Frontend URL (for CORS)
NODE_ENV=development
CLIENT_URL=http://localhost:5173
